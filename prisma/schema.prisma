// Sofra control plane — partner program v1 (SOFRA-PARTNER-PLAN.md).
// Prisma 7: no Rust engine; runtime goes through @prisma/adapter-pg (see lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PARTNER
  // Direct restaurant owner (ADR-004 self-serve): pays for their own tenant, no
  // reseller relationship. Onboarded from a signup lead; dashboard = own plan only.
  OWNER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Where a party's VAT identification number stands with VIES
// (SOFRA-BILLING-IDENTITY-PLAN B1/B2). Mirrors lib/vies-result.ts's tri-valued
// outcome plus the two "nothing to check" states.
//
// UNAVAILABLE is NOT a synonym for INVALID and must never be written over a
// VALID: VIES answers `valid:false` for its own outages too (the French node
// throttled 5 of 8 calls during the plan's research while reporting itself
// Available), so collapsing the two turns a busy member state into a rejected
// customer — and silently retracts a reverse charge substantiated last quarter.
enum VatStatus {
  NONE // no number supplied
  UNCHECKED // supplied, never checked
  VALID // VIES said valid — vatCheckRef is the consultation reference
  INVALID // a real member-state verdict
  UNAVAILABLE // VIES could not answer; ask again, decide nothing
}

enum SignupStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

enum ClientStatus {
  LEAD
  CONTACTED
  DEMO_SCHEDULED
  AGREED
  ONBOARDING
  LIVE
  CHURNED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  name         String
  role         UserRole   @default(PARTNER)
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())

  profile        PartnerProfile?
  clients        Client[]
  notes          ClientNote[]
  commissions    CommissionEntry[] @relation("PartnerCommissions")
  createdEntries CommissionEntry[] @relation("EntryAuthor")
  inviteTokens   InviteToken[]
  auditLogs      AuditLog[]
  // Tenants this user pays for directly (OWNER self-serve; ADR-004).
  billingsPaid   TenantBilling[]   @relation("BillingPayer")
  // The legal entity this user is invoiced as (B1). One per user: a party has
  // one set of registration details at a time.
  billingIdentity BillingIdentity?
}

model PartnerApplication {
  id        String            @id @default(cuid())
  name      String
  email     String
  company   String?
  city      String?
  message   String
  locale    String            @default("en")
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
}

// Direct (non-partner) restaurant signup intake (ADR-004 self-serve v1). A
// public form drops a NEW row + founder email; conversion stays founder-operated
// via /admin/onboard until the auto-provisioning hook lands. Mirrors
// PartnerApplication (a lead queue, not a User/Client yet).
model SignupRequest {
  id             String       @id @default(cuid())
  restaurantName String
  contactName    String
  email          String
  phone          String?
  city           String?
  desiredSlug    String?
  message        String?
  locale         String       @default("en")
  status         SignupStatus @default(NEW)
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  // --- Product choices from the public configurator (SOFRA-ONBOARDING-PLAN O1) ---
  // Stored as the SAME comma-separated grammar the registry and provision-tenant.sh
  // already consume, so a lead's answers travel to the tenant env without a format
  // change. Not text[]: these are opaque payload carried to the provisioner, never
  // queried by element, and every consumer on the path speaks CSV.
  // All nullable — leads captured before the configurator shipped have none, and a
  // null here means "the founder still chooses", exactly as before.
  modules     String?
  languages   String?
  template    String?
  currency    String?
  /// Monthly total in EUR integer cents as quoted at signup. A record of what they
  /// were shown, NOT a price that binds — always re-quote at onboarding.
  quotedCents Int?

  // Back-reference for the O3 link. A list because Prisma requires it on the
  // non-owning side; in practice at most one plan is minted per lead.
  billing TenantBilling[]

  @@index([status, createdAt])
}

// The legal entity an invoice is addressed to (SOFRA-BILLING-IDENTITY-PLAN B1).
//
// Attached to the PARTY, not to the subscription, and that is the whole design
// decision: one partner can hold several tenants (`resolvePartnerUser` reuses an
// existing ACTIVE partner by design), so legal fields on TenantBilling would be
// duplicated per tenant and drift. TenantBilling points here instead.
//
// `userId` is nullable so the founder can record an identity for a tenant that
// has no login yet — RUMI's case, which predates every account in this table.
//
// NOT stored, deliberately: the raw VIES response body. The evidence that
// matters is the consultation reference plus the date it was issued, which are
// their own columns; a JSON blob of the whole answer would only invite keeping
// more third-party data than the audit needs (D7 minimization).
model BillingIdentity {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The name that goes on the invoice. For a sole trader this is the PERSON,
  /// not the brand they trade under — the trade name is a separate field below.
  legalName      String
  tradeName      String?
  legalForm      String?
  /// Whatever the country issues: SIREN (FR), KVK (NL), CHE/UID (CH).
  registrationNo String?
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  /// ISO 3166-1 alpha-2, UPPERCASE. Drives the entire tax matrix
  /// (lib/tax-treatment.ts) — the single most load-bearing field here.
  countryCode    String
  billingEmail   String

  /// Normalized: uppercase, no separators, WITH the country prefix.
  vatNumber      String?
  vatStatus      VatStatus @default(NONE)
  vatCheckedAt   DateTime?
  /// VIES consultation reference — THE audit evidence, and it only exists when
  /// the check identified us as requester (see lib/vies.ts). Null on a VALID row
  /// means "checked, but we cannot prove it", which is a different thing from
  /// unchecked and is why it is stored separately from the status.
  vatCheckRef    String?
  /// The error VIES named, when it named one. Kept for operator diagnosis.
  vatCheckDetail String?
  /// The registered name the member state holds, when it returns one. Worth
  /// keeping beside `legalName` — a mismatch is a signal, not an error.
  vatCheckName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billings TenantBilling[]
  invoices Invoice[]

  // Drives the ICP listing (B7): reverse-charged EU sales, grouped by country.
  @@index([countryCode, vatStatus])
}

// An issued invoice (SOFRA-BILLING-IDENTITY-PLAN B4). Immutable once written:
// nothing in the app updates one, and a correction is a credit note (not built).
model Invoice {
  id     String @id @default(cuid())
  /// Gapless within (series, year) — allocated under a transaction-scoped
  /// advisory lock, never by counting rows outside one. See lib/invoicing.ts.
  number String @unique
  series String @default("SP")
  year   Int
  seq    Int

  issuedAt DateTime @default(now())

  /// IMMUTABLE SNAPSHOTS of both parties, copied in at issue time and never
  /// joined at render time. An invoice must not silently change when the
  /// customer edits their address, or when Sofra moves office — the document
  /// records what was true on the day it was issued, which is the whole point of
  /// keeping one.
  sellerSnapshot Json
  buyerSnapshot  Json

  /// Kept as a real relation as well, so the ICP export can group by party
  /// without parsing JSON. RESTRICT, unlike everywhere else in this schema: an
  /// identity with invoices against it must not be deletable, because the
  /// invoice would lose the party it is addressed to.
  billingIdentityId String
  billingIdentity   BillingIdentity @relation(fields: [billingIdentityId], references: [id], onDelete: Restrict)

  tenantSlug String

  currency   String @default("EUR")
  netCents   Int
  vatCents   Int
  grossCents Int
  /// Basis points: 2100 = 21%, 0 = reverse charge or outside scope.
  vatRateBps Int
  /// The lib/tax-treatment.ts verdict, stored as the string it decided.
  taxTreatment String
  /// The exact sentence printed on the document, e.g. "BTW verlegd …". Stored
  /// rather than re-derived so a later wording change cannot rewrite history.
  taxNote      String?

  /// The Mollie payment this invoices. UNIQUE, and that is the idempotency
  /// anchor: Mollie redelivers webhooks, so "have I already invoiced this
  /// charge?" must be answerable from our own rows.
  molliePaymentId String? @unique

  lines     InvoiceLine[]
  createdAt DateTime      @default(now())

  /// The backstop for the allocator: a lost race becomes a refused write rather
  /// than a silent duplicate number.
  @@unique([series, year, seq])
  @@index([billingIdentityId, issuedAt])
  @@index([tenantSlug, issuedAt])
  // The ICP listing is "everything reverse-charged in this quarter".
  @@index([taxTreatment, issuedAt])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitCents   Int
  netCents    Int
  /// The service period this line covers, when it is a subscription charge.
  periodStart DateTime?
  periodEnd   DateTime?

  @@index([invoiceId])
}

model PartnerProfile {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company String?
  phone   String?
  city    String?
  // Founder-only notes — never rendered in partner-facing views.
  notes   String?
}

model Client {
  id             String       @id @default(cuid())
  partnerId      String
  partner        User         @relation(fields: [partnerId], references: [id])
  restaurantName String
  contactName    String?
  email          String?
  phone          String?
  city           String?
  status         ClientStatus @default(LEAD)
  // Set by ADMIN only, after founder-operated provisioning (ADR-003/006).
  // Unique: two LIVE clients must never share a tenant.
  tenantSlug     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  clientNotes ClientNote[]
  commissions CommissionEntry[]
  billing     TenantBilling?

  @@index([partnerId, status])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model CommissionEntry {
  id          String   @id @default(cuid())
  partnerId   String
  partner     User     @relation("PartnerCommissions", fields: [partnerId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  amountCents Int
  // Sofra's books are EUR (NL company; flipped from CHF 2026-07-06 — the
  // stale CHF default is corrected in the mollie_billing migration).
  currency    String   @default("EUR")
  note        String
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("EntryAuthor", fields: [createdById], references: [id])

  @@index([partnerId, createdAt])
}

// --- Mollie subscription billing (S9 — ADR-005, ADR-011 Job A) -------------
// Sofra bills its tenants: one TenantBilling per tenant (keyed by the
// registry slug, optionally linked to the partner-CRM Client), holding the
// Mollie customer. Money is integer cents + explicit currency (EUR).
// Mollie is the source of truth for payment state — rows here are the local
// mirror, updated only from API re-fetches (never from raw webhook bodies).

enum SubscriptionStatus {
  PENDING // plan defined; waiting for the first payment to create the mandate
  ACTIVATING // claimed by a webhook worker; Mollie call in flight (self-heals)
  ACTIVE // subscription created at Mollie and charging
  CANCELED
  SUSPENDED
  COMPLETED
}

model TenantBilling {
  id               String    @id @default(cuid())
  // Registry slug (deploy repo tenants/registry.yml) — the billing anchor;
  // not a FK on purpose (the registry graduates to a table only at >3
  // tenants, ADR-007).
  tenantSlug       String    @unique
  name             String
  email            String
  // Null until the payer starts the first payment: an admin can define a
  // PENDING plan (partner onboarding) before any Mollie customer exists. The
  // @unique still holds — Postgres allows multiple NULLs.
  mollieCustomerId String?   @unique
  clientId         String?   @unique
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Explicit payer for the direct-owner flow (ADR-004): set when there is no
  // reseller Client. The reseller flow leaves this null and derives the payer
  // from client.partner. Exactly one of clientId / payerUserId is set in practice.
  payerUserId      String?
  payer            User?     @relation("BillingPayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  // Display-only: when the tenant's app went live (admin-entered at
  // onboarding), shown on the partner's welcome panel.
  liveSince        DateTime?
  createdAt        DateTime  @default(now())

  // The lead this plan was minted from (O3). Set only on the SELF-SERVE path, so
  // null means founder-created — the same signal the payment gate already keys on.
  // It exists because the configurator answers live on SignupRequest and the
  // payment-triggered proposal needs them; the only alternative join
  // (desiredSlug = tenantSlug) is soft and can select another lead's module list.
  // Not unique on purpose — the state is unreachable and the constraint would only add
  // a P2002 surface to the signup transaction. See the migration for the full reasoning.
  signupRequestId   String?
  signupRequest     SignupRequest? @relation(fields: [signupRequestId], references: [id], onDelete: SetNull)
  // Who this subscription is INVOICED to (B1). Nullable because every row that
  // existed before this column has no identity and none can be invented for it —
  // an absent identity is the honest state, and it is what blocks invoicing.
  // Several plans can share one identity: a reseller partner holding three
  // tenants is one legal entity with three subscriptions.
  billingIdentityId String?
  billingIdentity   BillingIdentity? @relation(fields: [billingIdentityId], references: [id], onDelete: SetNull)
  // The registry proposal opened for this tenant. Also the auto-open's idempotency
  // record: Mollie redelivers, so "already proposed?" must be answerable from our
  // own rows, not only from GitHub refusing a duplicate branch.
  provisioningPrUrl String?

  subscriptions BillingSubscription[]
  payments      BillingPayment[]

  @@index([payerUserId])
  @@index([signupRequestId])
  @@index([billingIdentityId])
}

model BillingSubscription {
  id                   String             @id @default(cuid())
  billingId            String
  billing              TenantBilling      @relation(fields: [billingId], references: [id], onDelete: Cascade)
  // Set when the subscription is created at Mollie (after the first payment
  // validates the mandate); null while PENDING.
  mollieSubscriptionId String?            @unique
  description          String
  amountCents          Int
  currency             String             @default("EUR")
  interval             String             @default("1 month") // Mollie grammar
  status               SubscriptionStatus @default(PENDING)
  startDate            DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())

  @@index([billingId, createdAt])
}

model BillingPayment {
  id                   String        @id @default(cuid())
  billingId            String
  billing              TenantBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  molliePaymentId      String        @unique
  mollieSubscriptionId String?
  amountCents          Int
  currency             String        @default("EUR")
  description          String
  status               String // Mollie statuses verbatim: open|pending|paid|failed|canceled|expired|authorized
  sequenceType         String // first | recurring | oneoff
  method               String?
  // Hosted-checkout URL — only meaningful while status is open/pending.
  checkoutUrl          String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([billingId, createdAt])
}

// Set-password invites and password resets. Token stored hashed, single-use.
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("invite") // "invite" | "reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Fleet observability roll-up (Track S; docs/plans/PRINTER-APP-FLEET-OBSERVABILITY-PLAN.md).
// A compact per-tenant snapshot pushed one-directionally by each tenant backend's
// FleetSummaryPushService (bearer-authed — devices/backends hold no sofra credential, sofra
// holds no backend credential). Keyed on the registry slug, NOT a FK (same rationale as
// TenantBilling.tenantSlug — the registry graduates to a table only at >3 tenants). Non-PII:
// no customer data, no API keys, no raw orders — only device roster + counts.
model FleetSummary {
  id           String   @id @default(cuid())
  tenantSlug   String   @unique
  deviceCount  Int      @default(0)
  missedOrders Int      @default(0)
  recentErrors Int      @default(0)
  reportedAt   DateTime // the backend's snapshot time
  receivedAt   DateTime @default(now()) // sofra ingest time
  updatedAt    DateTime @updatedAt
}

model FleetDevice {
  id                   String    @id @default(cuid())
  tenantSlug           String
  deviceId             String
  label                String?
  platform             String?
  appVersion           String?
  feedRunning          Boolean   @default(false)
  lastHeartbeatAt      DateTime?
  lastSuccessfulPollAt DateTime?
  apiBaseUrl           String?
  kitchenPrinter       String?
  cashierPrinter       String?
  updatedAt            DateTime  @updatedAt

  @@unique([tenantSlug, deviceId])
  @@index([tenantSlug])
}
